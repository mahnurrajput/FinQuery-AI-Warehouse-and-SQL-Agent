# Read-only app connection (Streamlit + LangChain)
DB_HOST=psql-dw-etl-prod.postgres.database.azure.com
DB_PORT=5432
DB_NAME=finquery_dw_ai
DB_USER=finquery_readonly
DB_PASSWORD=your_password_here

# Privileged connection (MOLAP refresh only — never used by the app)
MOLAP_REFRESH_DB_USER=dw_admin
MOLAP_REFRESH_DB_PASSWORD=your_admin_password_here

# Gemini
GOOGLE_API_KEY=your_gemini_api_key_here